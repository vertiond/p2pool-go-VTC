#!/usr/bin/env bash
# Reproducible build of p2pool-go-VTC with Guix. See contrib/guix/README.md.
#
#   ./contrib/guix/guix-build
#
# Environment:
#   HOSTS      platforms to build (default: "x86_64-linux-gnu x86_64-w64-mingw32",
#              the Linux and Windows x64 builds CI makes)
#   VERSION    version to name the zips after, such as v1.2.0. The binary is
#              stamped <VERSION>-g<commit>, as CI does for a tag. Unset, it is
#              the tag on HEAD; with no tag on HEAD (or VERSION=), the zips are
#              named dev-<commit> and the binary dev-g<commit>, as CI does for a
#              branch.
#   JOBS       parallel jobs (default: nproc)
#   CACHE_PATH where the Go modules are kept between builds (default:
#              ./guix-cache). Everything in it is checked against go.sum.
#   SUBSTITUTE_URLS
#              substitute servers to use instead of the daemon's defaults
#   ADDITIONAL_GUIX_COMMON_FLAGS
#              extra flags for guix time-machine, as in Bitcoin Core
export LC_ALL=C
set -o errexit -o pipefail -o nounset

cd "$(git rev-parse --show-toplevel)"

# The Guix commit every package comes from. Changing it changes the output.
# It is the one Bitcoin Core v32.0 pins, as the One Click Miner does.
GUIX_COMMIT=c5eee3336cc1d10a3cc1c97fde2809c3451624d3

HOSTS="${HOSTS:-x86_64-linux-gnu x86_64-w64-mingw32}"
JOBS="${JOBS:-$(nproc)}"
CACHE_PATH="${CACHE_PATH:-$PWD/guix-cache}"
VERSION="${VERSION-$(git describe --exact-match --tags HEAD 2>/dev/null || true)}"

# The build is of the commit, not the working tree, so refuse to run when they differ
if [ -n "$(git status --porcelain --untracked-files=no)" ]; then
    echo "ERR: the working tree has uncommitted changes; commit or stash them first" >&2
    git status --short --untracked-files=no >&2
    exit 1
fi

COMMIT="$(git rev-parse HEAD)"
SHORT="${COMMIT:0:12}"
# The names and version string CI uses, which take a 7-character commit
CI_SHORT="${COMMIT:0:7}"
if [ -n "$VERSION" ]; then
    NAME="$VERSION"
    GO_VERSION="${VERSION}-g${CI_SHORT}"
else
    NAME="dev-${CI_SHORT}"
    GO_VERSION="dev-g${CI_SHORT}"
fi
SOURCE_DATE_EPOCH="${SOURCE_DATE_EPOCH:-$(git log -1 --format=%ct HEAD)}"

# Named like the zips, as Bitcoin Core does
BUILD_BASE="$PWD/guix-build-${NAME}"
DIST_BASE="${BUILD_BASE}/dist-archive"
OUTDIR_BASE="${BUILD_BASE}/output"
DISTSRC_BASE="${BUILD_BASE}/distsrc"

for host in $HOSTS; do
    case "$host" in
        x86_64-linux-gnu|x86_64-w64-mingw32) ;;
        *) echo "ERR: unsupported host '$host'" >&2; exit 1 ;;
    esac
    if [ -e "${OUTDIR_BASE}/${host}" ]; then
        echo "ERR: ${OUTDIR_BASE}/${host} already exists; remove it to rebuild" >&2
        exit 1
    fi
done

mkdir -p "$DIST_BASE" "$OUTDIR_BASE" "$DISTSRC_BASE" "$CACHE_PATH"

# git archive output depends only on the commit
SRC_TAR="${DIST_BASE}/p2pool-go-vtc-${SHORT}.tar"
[ -e "$SRC_TAR" ] || git archive --format=tar --prefix=src/ --output="$SRC_TAR" HEAD

time-machine() {
    # shellcheck disable=SC2086
    guix time-machine --url=https://codeberg.org/guix/guix.git \
                      --commit="$GUIX_COMMIT" \
                      --cores="$JOBS" \
                      --keep-failed \
                      --fallback \
                      ${SUBSTITUTE_URLS:+--substitute-urls="$SUBSTITUTE_URLS"} \
                      ${ADDITIONAL_GUIX_COMMON_FLAGS:-} \
                      -- "$@"
}

# Container flags shared by both steps:
#   --container --pure --no-cwd  nothing from this machine's environment or
#                                 working directory reaches the build
#   --rebuild-cache               guix shell caches the profile per manifest file
#                                 and ignores HOST, which the manifest reads, so
#                                 without it every step gets the first step's profile
#   --expose                      the scripts and the source archive, read-only
container=(
    --manifest="$PWD/contrib/guix/manifest.scm"
    --rebuild-cache
    --container
    --pure
    --no-cwd
    --expose="$PWD/contrib/guix/libexec=/libexec"
    --expose="$DIST_BASE=/dist"
    --share="$CACHE_PATH=/cache"
)

echo "Fetching Go modules for ${SHORT} into ${CACHE_PATH}"
HOST=fetch time-machine shell "${container[@]}" --network -- \
    env SRC_TAR="/dist/$(basename "$SRC_TAR")" \
    bash /libexec/fetch.sh

for host in $HOSTS; do
    echo "Building ${host} for ${SHORT} as ${GO_VERSION}"
    rm -rf "${DISTSRC_BASE:?}/${host}"
    mkdir -p "${DISTSRC_BASE}/${host}" "${OUTDIR_BASE}/${host}"
    # No --network: the build sees only the archive and the fetched modules
    HOST="$host" time-machine shell "${container[@]}" \
        --share="${DISTSRC_BASE}/${host}=/distsrc" \
        --share="${OUTDIR_BASE}/${host}=/outdir" -- \
        env HOST="$host" \
            JOBS="$JOBS" \
            NAME="$NAME" \
            GO_VERSION="$GO_VERSION" \
            SOURCE_DATE_EPOCH="$SOURCE_DATE_EPOCH" \
            SRC_TAR="/dist/$(basename "$SRC_TAR")" \
        bash /libexec/build.sh
done

echo
echo "Outputs in ${OUTDIR_BASE}:"
cat "${OUTDIR_BASE}"/*/SHA256SUMS.part
